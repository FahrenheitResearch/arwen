&share
 wrf_core = 'ARW',
 max_dom = 1,
 interval_seconds = 10800,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 402,
 e_sn              = 402,
 geog_data_res     = 'default',
 dx = 3000.0,
 dy = 3000.0,
 map_proj = 'lambert',
 ref_lat   = 38.5,
 ref_lon   = -97.5,
 truelat1  = 38.5,
 truelat2  = 38.5,
 stand_lon = -97.5,
/
