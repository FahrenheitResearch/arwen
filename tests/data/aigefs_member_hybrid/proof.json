      "wrf_reference": {
        "gpuwm_behaviour": "WRF's own linear-in-depth blend toward TMN is applied to the part of TMN the source mesh cannot represent, leaving the source-cell mean of every layer exactly unchanged",
        "reproduce_wrf": "[ingest] soil_texture_downscale = false",
        "wrf_behaviour": "init_soil_2_real (share/module_soil_pre.F:1591-1608) anchors the soil column on TMN at 3 m for level-form sources, but a layer-form source whose layers already match Noah's is copied straight through and never sees the target grid's deep-soil climatology"
      }
    },
