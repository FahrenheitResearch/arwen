    "non_feature_physical": {
      "input_toml": "# The quick HRRR demo: one 118 x 112 x 49 domain at 3 km over the southern\n# Great Plains, one forecast hour from the 00Z cycle, a wrfout every 15\n# minutes.  It exists to be run in a few minutes, end to end, on a small\n# card -- fetch, prepare, integrate, render -- and it is the smallest thing\n# that still runs HRRR at HRRR's own spacing.\n#\n# source: hrrr (native hybrid levels).  Two commands run it:\n#   gpuwm prep --source hrrr ... --output-root DIR   (the companions beside\n#       this file supply --domain-spec, --namelist-input, --wps-namelist)\n#   gpuwm sim DIR --experiment-config DIR/experiment.toml\n#       --wps-namelist DIR/namelist.wps --outdir OUT\n#\n# Prior YSU/MM5 suite measurements, before selecting MYNN below:\n# sized for a 10 GiB card: emitted by `gpuwm domain --vram-gib 10`, whose\n# forecast peak envelope is 7.67 GiB against that card's 8.75 GiB budget --\n# 1.08 GiB of headroom.\n# measured peak VRAM: 6062 MiB (5.92 GiB) held by the forecast process,\n# sampled once a second on an RTX 5070 Ti under Linux.\n# measured wall time: fetch 81 s (2.1 GB of wrfnat + wrfprs), prepare 30 s,\n# forecast 72 s (48 s of that the one-time NVRTC kernel compile), render\n# 18 s for 945 product PNGs across the five frames.\n#\n# PHYSICS: Thompson mp8, MYNN PBL and MYNN surface layer with the\n# GSL WRF39 surface generation, Noah, and legacy RRTMG on both streams.\n# mp_physics 8, longwave\n# legacy RRTMG, shortwave legacy RRTMG (radt 12 min), NO cumulus\n# parameterization, bl_pbl_physics 5, sf_surface_physics 2.\n# cu_physics = 0 is the route's own\n# requirement, and it is the right answer at 3 km: the grid resolves deep\n# convection, so parameterizing it would count the same overturning twice.\n# NOCTURNALLY VALID: longwave and shortwave both run, so the surface longwave\n# budget stays closed through the night -- and this 00Z window is local\n# night over the domain.\n\n[experiment]\nname = \"hrrr_native_quick_demo\"\nstart_time = 2026-08-20T00:00:00\nrun_seconds = 3600.0\nfeedback = 0\nsmooth_option = 0\nblend_width = 5\nspec_bdy_width = 5\nrestart_interval_s = 0.0\n\n[projection]\nmap_proj = \"lambert\"\nref_lat = 35.3\nref_lon = -97.5\ntruelat1 = 25.3\ntruelat2 = 45.3\nstand_lon = -97.5\n\n[shared]\nmynn_sfclay_variant = \"gsl_wrf39\"\nterrain_clock = \"pinned\"\ndiff_6th_form = \"noaa_wrf39\"\ndiff_6th_factor2 = 0.04\nmp_zero_out = 2\nmp_zero_out_thresh = 1e-12\nmp_zero_out_all = 1\nupper_wind_limiter_form = \"noaa_wrf39\"\nnz = 49\nztop = 20000.0\np_top = 10000.0\neta_levels = [\n    1.0, 0.9978, 0.99519, 0.99212, 0.98849,\n    0.98422, 0.97918, 0.97325, 0.96627, 0.95808,\n    0.94846, 0.93719, 0.92402, 0.90866, 0.89079,\n    0.87006, 0.84612, 0.81857, 0.78706, 0.75124,\n    0.7108, 0.66556, 0.61547, 0.56067, 0.50519,\n    0.45474, 0.40886, 0.36713, 0.32918, 0.29466,\n    0.26328, 0.23473, 0.20877, 0.18516, 0.16369,\n    0.14417, 0.12641, 0.11026, 0.09557, 0.08222,\n    0.07007, 0.05902, 0.04898, 0.03984, 0.03153,\n    0.02398, 0.0171, 0.01085, 0.00517, 0.0,\n]\nhybrid_opt = 2\netac = 0.2\nbase_temp = 290.0\ntime_step_sound = 4\nemdiv = 0.01\nhypsometric_opt = 2\nh_sca_adv_order = 5\nsmdiv = 0.1\nmoist_adv_opt = 1\nw_damping = 1\ndamp_opt = 3\nzdamp = 5000.0\ndampcoef = 0.2\nkhdif = 0.0\nkvdif = 0.0\nspec_zone = 1\nrelax_zone = 4\nbldt = 0.0\nnwp_diagnostics = 1\nmoist = true\nmoist_cq = true\nmp_physics = 8\ntop_lid = false\nepssm = 0.5\nmorr_rimed_ice = 1\nwsm6_hail_opt = 0\nra_physics = 0\nra_lw_physics = 4\nra_sw_physics = 4\nalb_sol = 1\nwrf_rrtmg_compatibility = \"wrf-rrtmg-4-4-legacy-v1\"\nra_rrtmg_variant = \"rrtmg_legacy\"\nsf_sfclay_physics = 5\nsf_surface_physics = 2\nbl_pbl_physics = 5\nnum_soil_layers = 4\nterrain_opt = 1\nkm_opt = 4\ndiff_6th_opt = 2\ndiff_6th_slopeopt = 1\nmap_proj = 1\n\n[[domain]]\nv_sca_adv_order = 5\nv_mom_adv_order = 5\ngrid_id = 1\nparent_id = 0\ni_parent_start = 1\nj_parent_start = 1\nparent_grid_ratio = 1\nparent_time_step_ratio = 1\nnx = 118\nny = 112\ntime_step = 15\ndx = 3000.0\nspecified = true\nnested = false\nhistory_interval_s = 900.0\nradt = 12.0\ncu_physics = 0\ncudt_minutes = 0.0\ndiff_6th_factor = 0.12\n\n# Advisory data-acquisition hints (validated, not executed); keys mirror `gpuwm fetch` flags.\n[fetch]\nsource = \"hrrr\"\ncycle = \"2026-08-20T00\"\nhours = 1\narea = \"31.75,-101.52,38.83,-93.48\"\nout = \"data/hrrr_native_quick_demo\"\n",
