&share
 wrf_core = 'ARW',
 max_dom = 3,
 interval_seconds = 300,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 13, 19,
 j_parent_start    = 1, 13, 19,
 e_we              = 49, 73, 109,
 e_sn              = 49, 73, 109,
 geog_data_res     = 'default', 'default', 'default',
 dx = 1000,
 dy = 1000,
 map_proj = 'lambert',
 ref_lat   = 36.0,
 ref_lon   = -91.0,
 truelat1  = 26.0,
 truelat2  = 46.0,
 stand_lon = -91.0,
/
