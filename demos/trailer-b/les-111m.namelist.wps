&share
 wrf_core = 'ARW',
 max_dom = 3,
 interval_seconds = 300,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1, 2,
 parent_grid_ratio = 1, 3, 3,
 i_parent_start    = 1, 31, 46,
 j_parent_start    = 1, 31, 46,
 e_we              = 121, 181, 271,
 e_sn              = 121, 181, 271,
 geog_data_res     = 'default', 'default', 'default',
 dx = 1000,
 dy = 1000,
 map_proj = 'lambert',
 ref_lat   = 39.68,
 ref_lon   = -83.94,
 truelat1  = 29.68,
 truelat2  = 49.68,
 stand_lon = -83.94,
/
