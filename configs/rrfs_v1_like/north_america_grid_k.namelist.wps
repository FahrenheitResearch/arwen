&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-10-03_12:00:00',
 end_date   = '2026-10-07_00:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 4441,
 e_sn              = 2489,
 geog_data_res     = 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'polar',
 ref_lat   = 51.74,
 ref_lon   = -113.03,
 truelat1  = 45.0,
 truelat2  = 45.0,
 stand_lon = -120.0,
 geog_data_path = 'WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
