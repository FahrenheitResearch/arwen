! ptop A/B, CONTROL arm: the shipped default model top (p_top_requested 10000 Pa,
! the 100 hPa lid the wizard's _SHARED_GRID_AND_DYNAMICS emits).  Adapted from
! configs/hrrr_native_3km_demo.namelist.input: grid moved to the 2026-08-24
! Nebraska/South Dakota convective corridor (SPC-reported hail 2143-0130 UTC),
! enlarged to 232 x 184 at 3 km (1.478x the 10 GiB demo's cells; the demo
! measured 6486 MiB on an RTX 5070 Ti, linear scaling prices this at ~9.6 GiB
! on the 16 GiB card), and lengthened to 18 forecast hours so the obs-battery
! registration's default scoring window (leads 2..18) fits inside the run.
! The TREATMENT twin differs in exactly one value: p_top_requested.
&time_control
 run_days                            = 0,
 run_hours                           = 18,
 run_minutes                         = 0,
 run_seconds                         = 0,
 start_year                         = 2026,
 start_month                        = 08,
 start_day                          = 24,
 start_hour                         = 18,
 start_minute                       = 00,
 start_second                       = 00,
 end_year                         = 2026,
 end_month                        = 08,
 end_day                          = 25,
 end_hour                         = 12,
 end_minute                       = 00,
 end_second                       = 00,
 interval_seconds                    = 3600,
 input_from_file                     = .true.,
 history_interval_s                  = 3600,
 frames_per_outfile                  = 1,
 restart                             = .false.,
 io_form_history                     = 2,
 io_form_restart                     = 2,
 io_form_input                       = 2,
 io_form_boundary                    = 2,
/

&domains
 time_step                           = 15,
 max_dom                             = 1,
 e_we                                = 233,
 e_sn                                = 185,
 e_vert                              = 50,
 eta_levels = 1.00000, 0.99780, 0.99519, 0.99212, 0.98849,
              0.98422, 0.97918, 0.97325, 0.96627, 0.95808,
              0.94846, 0.93719, 0.92402, 0.90866, 0.89079,
              0.87006, 0.84612, 0.81857, 0.78706, 0.75124,
              0.71080, 0.66556, 0.61547, 0.56067, 0.50519,
              0.45474, 0.40886, 0.36713, 0.32918, 0.29466,
              0.26328, 0.23473, 0.20877, 0.18516, 0.16369,
              0.14417, 0.12641, 0.11026, 0.09557, 0.08222,
              0.07007, 0.05902, 0.04898, 0.03984, 0.03153,
              0.02398, 0.01710, 0.01085, 0.00517, 0.00000,
 p_top_requested                     = 10000.0,
 hypsometric_opt                     = 2,
 dx                                  = 3000.0,
 dy                                  = 3000.0,
 grid_id                             = 1,
 parent_id                           = 0,
 i_parent_start                      = 1,
 j_parent_start                      = 1,
 parent_grid_ratio                   = 1,
 parent_time_step_ratio              = 1,
 feedback                            = 0,
 smooth_option                       = 0,
 num_metgrid_levels                  = 51,
 num_metgrid_soil_levels             = 9,
 sfcp_to_sfcp                        = .true.,
/

&physics
 mp_physics                          = 8,
 ra_lw_physics                       = 4,
 ra_sw_physics                       = 4,
 radt                                = 12.0,
 icloud                              = 1,
 swrad_scat                          = 1.0,
 sf_sfclay_physics                   = 91,
 sf_surface_physics                  = 2,
 bl_pbl_physics                      = 1,
 bldt                                = 0.0,
 cu_physics                          = 0,
 cudt                                = 0.0,
 isfflx                              = 1,
 ifsnow                              = 1,
 surface_input_source                = 1,
 num_soil_layers                     = 4,
 num_land_cat                        = 21,
 sf_urban_physics                    = 0,
 sst_update                          = 0,
/

&fdda
/

&dynamics
 use_theta_m                         = 0,
 hybrid_opt                          = 2,
 etac                                = 0.2,
 top_lid                             = .false.,
 w_damping                           = 1,
 epssm                               = 0.5,
 diff_opt                            = 2,
 km_opt                              = 4,
 mix_full_fields                     = .true.,
 diff_6th_opt                        = 2,
 diff_6th_factor                     = 0.12,
 diff_6th_slopeopt                   = 1,
 moist_mix6_off                      = .false.,
 c_s                                 = 0.25,
 diff_6th_thresh                     = 0.1,
 base_temp                           = 290.0,
 damp_opt                            = 3,
 zdamp                               = 5000.0,
 dampcoef                            = 0.2,
 khdif                               = 0.0,
 kvdif                               = 0.0,
 non_hydrostatic                     = .true.,
 moist_adv_opt                       = 1,
 scalar_adv_opt                      = 1,
 time_step_sound                     = 4,
 smdiv                               = 0.1,
 emdiv                               = 0.01,
 h_sca_adv_order                     = 5,
/

&bdy_control
 spec_bdy_width                      = 5,
 spec_zone                           = 1,
 relax_zone                          = 4,
 spec_exp                            = 0.0,
 specified                          = .true.,
 nested                             = .false.,
/

&grib2
/

&namelist_quilt
 nio_tasks_per_group                 = 0,
 nio_groups                          = 1,
/
