&share
 wrf_core = 'ARW',
 max_dom = 2,
 interval_seconds = 21600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 98,
 j_parent_start    = 1, 111,
 e_we              = 301, 151,
 e_sn              = 251, 151,
