 dx = 6000,
 dy = 6000,
 map_proj = 'lambert',
 ref_lat   = 31.9,
 ref_lon   = -88.8,
 truelat1  = 21.9,
 truelat2  = 41.9,
 stand_lon = -88.8,
/
