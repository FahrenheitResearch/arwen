&share
 wrf_core = 'ARW',
 max_dom = 4,
 interval_seconds = 10800,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1, 1, 1,
 parent_grid_ratio = 1, 3, 3, 3,
 i_parent_start    = 1, 35, 85, 135,
 j_parent_start    = 1, 60, 45, 60,
 e_we              = 201, 121, 121, 121,
 e_sn              = 161, 121, 121, 121,
 geog_data_res     = 'default', 'default', 'default', 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 22.0,
 ref_lon   = -60.0,
 truelat1  = 12.0,
 truelat2  = 32.0,
 stand_lon = -60.0,
/
