&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '1974-04-03_18:00:00',
 end_date   = '1974-04-03_21:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 51,
 e_sn              = 51,
 geog_data_res     = 'default',
 dx = 30000,
 dy = 30000,
 map_proj = 'lambert',
 ref_lat   = 40.0,
 ref_lon   = -92.5,
 truelat1  = 30.0,
 truelat2  = 60.0,
 stand_lon = -92.5,
 geog_data_path = 'WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'TWENTYCRV3',
/

&metgrid
 fg_name = 'TWENTYCRV3',
 io_form_metgrid = 2,
/
