&share
 wrf_core = 'ARW',
 max_dom = 2,
 interval_seconds = 21600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 4,
 i_parent_start    = 1, 26,
 j_parent_start    = 1, 21,
 e_we              = 99, 193,
 e_sn              = 81, 161,
 geog_data_res     = 'default', 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 35.3,
 ref_lon   = -97.5,
 truelat1  = 25.3,
 truelat2  = 45.3,
 stand_lon = -97.5,
/
