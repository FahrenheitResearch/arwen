&share
 wrf_core = 'ARW',
 max_dom = 1,
 interval_seconds = 3600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 181,
 e_sn              = 145,
 geog_data_res     = 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 50.0,
 ref_lon   = 9.0,
 truelat1  = 40.0,
 truelat2  = 60.0,
 stand_lon = 9.0,
/
