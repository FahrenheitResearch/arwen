&share
 wrf_core = 'ARW',
 max_dom = 1,
 interval_seconds = 3600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 233,
 e_sn              = 185,
 geog_data_res     = 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   = 44.2,
 ref_lon   = -101.0,
 truelat1  = 34.2,
 truelat2  = 54.2,
 stand_lon = -101.0,
/
