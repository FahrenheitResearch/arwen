&share
 wrf_core = 'ARW',
 max_dom = 1,
 interval_seconds = 10800,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 51,
 e_sn              = 51,
 geog_data_res     = 'default',
 dx = 24000,
 dy = 24000,
 map_proj = 'lambert',
 ref_lat   = 33.0,
 ref_lon   = -87.0,
 truelat1  = 23.0,
 truelat2  = 43.0,
 stand_lon = -87.0,
/
