&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2011-04-27_12:00:00',
 end_date   = '2011-04-28_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 193,
 e_sn              = 193,
 geog_data_res     = 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   = 34.5,
 ref_lon   = -88.0,
 truelat1  = 30.0,
 truelat2  = 45.0,
 stand_lon = -88.0,
 geog_data_path = '/root/case2011/geog-subset-2011',
/

&ungrib
 out_format = 'WPS',
 prefix = 'ERA5',
/

&metgrid
 fg_name = 'ERA5',
 io_form_metgrid = 2,
/
