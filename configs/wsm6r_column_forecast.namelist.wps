&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2024-05-21_18:00:00',
 end_date   = '2024-05-21_19:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 51,
 e_sn              = 51,
 geog_data_res     = 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   = 40.6,
 ref_lon   = -93.7,
 truelat1  = 38.5,
 truelat2  = 38.5,
 stand_lon = -97.5,
 geog_data_path = 'WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'HRRRPRS',
/

&metgrid
 fg_name = 'HRRRPRS',
 io_form_metgrid = 2,
/
