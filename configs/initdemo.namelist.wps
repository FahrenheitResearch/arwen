&share
 wrf_core = 'ARW',
 max_dom = 2,
 interval_seconds = 3600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 56,
 j_parent_start    = 1, 45,
 e_we              = 219, 325,
 e_sn              = 177, 265,
 geog_data_res     = 'default', 'default',
 dx = 3000,
 dy = 3000,
 map_proj = 'lambert',
 ref_lat   = 38.5,
 ref_lon   = -99.5,
 truelat1  = 28.5,
 truelat2  = 48.5,
 stand_lon = -99.5,
/
