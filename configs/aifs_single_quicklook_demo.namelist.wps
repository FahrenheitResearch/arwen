&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-08-20_00:00:00',
 end_date   = '2026-08-20_06:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 61,
 e_sn              = 55,
 geog_data_res     = 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 40.0,
 ref_lon   = -92.5,
 truelat1  = 30.0,
 truelat2  = 50.0,
 stand_lon = -92.5,
 geog_data_path = 'WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'AIFS',
/

&metgrid
 fg_name = 'AIFS',
 io_form_metgrid = 2,
/
