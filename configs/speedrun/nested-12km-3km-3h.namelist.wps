&share
 wrf_core = 'ARW',
 max_dom = 2,
 interval_seconds = 10800,
 io_form_geogrid = 2,
/
&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 4,
 i_parent_start    = 1, 22,
 j_parent_start    = 1, 18,
 e_we              = 85, 169,
 e_sn              = 69, 137,
 geog_data_res     = 'default', 'default',
 dx = 12000,
 dy = 12000,
 map_proj = 'lambert',
 ref_lat   = 38.0,
 ref_lon   = -97.5,
 truelat1  = 28.0,
 truelat2  = 48.0,
 stand_lon = -97.5,
/
