{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arwen:case-catalog:v1",
  "title": "ArWen case catalog v1",
  "description": "Catalog data only. The ArWen loader additionally checks UTC, duplicate IDs, tier containment/order and native scientific contracts. Bounds describe required study coverage; native fitting reports actual grid extents.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "arwen.case-catalog.v1"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "type": "array"
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "provenance"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "required": [
    "schema",
    "catalog",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$",
      "not": {
        "enum": [
          "con",
          "prn",
          "aux",
          "nul",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      }
    },
    "bounds": {
      "type": "object",
      "properties": {
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "south",
        "west",
        "north",
        "east"
      ],
      "additionalProperties": false
    },
    "tier": {
      "type": "object",
      "properties": {
        "bounds_degrees": {
          "$ref": "#/$defs/bounds"
        },
        "root_dx_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nest_ratios": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2
          }
        },
        "run_hours": {
          "type": "integer",
          "minimum": 1
        },
        "nz": {
          "type": "integer",
          "minimum": 4
        },
        "history_interval_s": {
          "type": "integer",
          "minimum": 1
        },
        "physics_profile": {
          "type": "string",
          "minLength": 1
        },
        "native_overrides": {
          "$ref": "#/$defs/nativeOverrides"
        },
        "notes": {
          "type": "string"
        },
        "domain_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "grid_id": {
                "type": "integer",
                "minimum": 1
              },
              "center_lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "center_lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "dx_km": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width_km": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height_km": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "grid_id",
              "center_lat",
              "center_lon",
              "dx_km",
              "width_km",
              "height_km"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "root_dx_km",
        "nest_ratios",
        "run_hours"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "bounds_degrees"
          ]
        },
        {
          "required": [
            "domain_intents"
          ]
        }
      ]
    },
    "sourceOption": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "cycle_utc": {
          "type": "string",
          "minLength": 1
        },
        "forecast_start_hour": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "references": {
          "type": "array"
        },
        "metadata": {
          "type": "object"
        },
        "tier_schedules": {
          "type": "object",
          "properties": {
            "lower": {
              "type": "object",
              "properties": {
                "cycle_utc": {
                  "type": "string"
                },
                "run_hours": {
                  "type": "integer",
                  "minimum": 1
                },
                "forecast_start_hour": {
                  "type": "integer",
                  "minimum": 0
                },
                "metadata": {
                  "type": "object"
                },
                "cadence_hours": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "cycle_utc",
                "run_hours"
              ],
              "additionalProperties": false
            },
            "recommended": {
              "type": "object",
              "properties": {
                "cycle_utc": {
                  "type": "string"
                },
                "run_hours": {
                  "type": "integer",
                  "minimum": 1
                },
                "forecast_start_hour": {
                  "type": "integer",
                  "minimum": 0
                },
                "metadata": {
                  "type": "object"
                },
                "cadence_hours": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "cycle_utc",
                "run_hours"
              ],
              "additionalProperties": false
            },
            "upper": {
              "type": "object",
              "properties": {
                "cycle_utc": {
                  "type": "string"
                },
                "run_hours": {
                  "type": "integer",
                  "minimum": 1
                },
                "forecast_start_hour": {
                  "type": "integer",
                  "minimum": 0
                },
                "metadata": {
                  "type": "object"
                },
                "cadence_hours": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "cycle_utc",
                "run_hours"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "lower",
            "recommended",
            "upper"
          ],
          "additionalProperties": false
        },
        "cadence_hours": {
          "type": "integer",
          "minimum": 1
        },
        "tier_geometry": {
          "type": "object",
          "properties": {
            "lower": {
              "$ref": "#/$defs/tier"
            },
            "recommended": {
              "$ref": "#/$defs/tier"
            },
            "upper": {
              "$ref": "#/$defs/tier"
            }
          },
          "required": [
            "lower",
            "recommended",
            "upper"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "source",
        "cycle_utc"
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "event_kind": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "event": {
          "type": "object",
          "properties": {
            "start_utc": {
              "type": "string",
              "minLength": 1
            },
            "end_utc": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "start_utc",
            "end_utc"
          ],
          "additionalProperties": false
        },
        "source_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceOption"
          }
        },
        "recommended_source_option": {
          "$ref": "#/$defs/id"
        },
        "tiers": {
          "type": "object",
          "properties": {
            "lower": {
              "$ref": "#/$defs/tier"
            },
            "recommended": {
              "$ref": "#/$defs/tier"
            },
            "upper": {
              "$ref": "#/$defs/tier"
            }
          },
          "required": [
            "lower",
            "recommended",
            "upper"
          ],
          "additionalProperties": false
        },
        "physics_profile": {
          "type": "string",
          "minLength": 1
        },
        "native_overrides": {
          "$ref": "#/$defs/nativeOverrides"
        },
        "recommendations": {
          "type": "array"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array"
        },
        "research_recipe_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "event_kind",
        "source_options",
        "tiers"
      ],
      "additionalProperties": false
    },
    "nativeOverrides": {
