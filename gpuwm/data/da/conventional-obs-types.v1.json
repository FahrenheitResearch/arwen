{
  "schema": "gpuwm-da.conventional-obs-types.v1",
  "note": "One row per observation type the LETKF's conventional route assimilates. A row matches neutral-table rows (gpuwm-obs.table.v2) by source pattern, variable and measurement; its operator is chosen by what the number is (pressure_level: a point at its own pressure, interpolated in each member's own column; surface: the member's 2 m / 10 m diagnostics at the station), never by platform. A new platform is a new row. Errors are the row's own error column (the Rust front doors take it from NCEP's regional conventional error table, GSI's errtable for HRRR v4.1.21) times error_inflation, floored at error_floor. horizontal_m and vertical_m are Gaspari-Cohn full support radii in metres. gross_sigma is the background check: an observation is rejected when |y - mean H(x)| > gross_sigma * sqrt(sigma_o^2 + var H(x)). Rows sharing a batch must share its localization.",
  "defaults": {
    "window_before_seconds": 1800,
    "window_after_seconds": 1800,
    "surface_elevation_max_diff_m": 200,
    "superob": "mean of the reports that land on one gridpoint of one batch; their mean error is kept"
  },
  "types": [
    {"name": "aircraft-temperature", "source": "madis-acars", "variable": "temperature_k", "measurement": "aircraft_level", "operator": "pressure_level", "batch": "upper-temperature", "error_inflation": 1.0, "error_floor": 0.5, "gross_sigma": 5.0, "horizontal_m": 200000, "vertical_m": 4000, "use": true},
    {"name": "aircraft-wind-u", "source": "madis-acars", "variable": "wind_u_m_s", "measurement": "aircraft_level", "operator": "pressure_level", "batch": "upper-wind-u", "error_inflation": 1.0, "error_floor": 1.0, "gross_sigma": 5.0, "horizontal_m": 200000, "vertical_m": 4000, "use": true},
    {"name": "aircraft-wind-v", "source": "madis-acars", "variable": "wind_v_m_s", "measurement": "aircraft_level", "operator": "pressure_level", "batch": "upper-wind-v", "error_inflation": 1.0, "error_floor": 1.0, "gross_sigma": 5.0, "horizontal_m": 200000, "vertical_m": 4000, "use": true},
    {"name": "aircraft-dewpoint", "source": "madis-acars", "variable": "dewpoint_k", "measurement": "aircraft_level", "operator": "pressure_level", "batch": "upper-dewpoint", "error_inflation": 1.0, "error_floor": 1.0, "gross_sigma": 5.0, "horizontal_m": 200000, "vertical_m": 4000, "use": true, "level_min_pa": 30000},
