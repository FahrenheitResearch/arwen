    {"name": "aircraft-prepbufr-wind-v", "source": "prepbufr*", "variable": "wind_v_m_s", "measurement": "aircraft_level", "operator": "pressure_level", "batch": "upper-wind-v", "error_inflation": 1.0, "error_floor": 1.0, "gross_sigma": 5.0, "horizontal_m": 200000, "vertical_m": 4000, "use": true},
