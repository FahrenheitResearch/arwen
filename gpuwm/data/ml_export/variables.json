{
  "schema": "ml-export.variables/v1",
  "note": "One row per dataset variable. A row names its output name under each naming scheme, its ECMWF parameter id, CF standard name, units, the history fields it cannot be made without, the operator that makes it (rw-mlexport ops.rs) and, for a level variable, its below-ground rule. A new variable an existing operator can make is a new row; only a new operator is code. Rows with default true are exported when --variables is not given; level_kinds says which level sets a level row applies to.",
  "rows": [
    {
      "id": "geopotential",
      "kind": "level",
      "default": true,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "geopotential", "era5": "z"},
      "op": "geopotential",
      "fields": ["PH", "PHB", "P", "PB"],
      "below_ground": "ecmwf-geopotential",
      "units": "m**2 s**-2",
      "long_name": "Geopotential",
      "standard_name": "geopotential",
      "short_name": "z",
      "param_id": 129,
      "comment": "PH + PHB on the layer faces, averaged onto each mass level (the model's own definition of a mass level's geopotential, and wrf-python's), then put on the level."
    },
    {
      "id": "temperature",
      "kind": "level",
      "default": true,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "temperature", "era5": "t"},
      "op": "temperature",
      "fields": ["T", "P", "PB"],
      "below_ground": "ecmwf-temperature",
      "units": "K",
      "long_name": "Temperature",
      "standard_name": "air_temperature",
      "short_name": "t",
      "param_id": 130
    },
    {
      "id": "u_component_of_wind",
      "kind": "level",
      "default": true,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "u_component_of_wind", "era5": "u"},
      "op": "earth-wind:u",
      "fields": ["U", "V", "SINALPHA", "COSALPHA"],
      "below_ground": "lowest-level",
      "units": "m s**-1",
      "long_name": "U component of wind",
      "standard_name": "eastward_wind",
      "short_name": "u",
      "param_id": 131,
      "comment": "Earth-relative: U and V unstaggered onto mass points and rotated by the history file's SINALPHA and COSALPHA."
    },
    {
      "id": "v_component_of_wind",
      "kind": "level",
      "default": true,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "v_component_of_wind", "era5": "v"},
      "op": "earth-wind:v",
      "fields": ["U", "V", "SINALPHA", "COSALPHA"],
      "below_ground": "lowest-level",
      "units": "m s**-1",
      "long_name": "V component of wind",
      "standard_name": "northward_wind",
      "short_name": "v",
      "param_id": 132,
      "comment": "Earth-relative: U and V unstaggered onto mass points and rotated by the history file's SINALPHA and COSALPHA."
    },
    {
      "id": "specific_humidity",
      "kind": "level",
      "default": true,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "specific_humidity", "era5": "q"},
      "op": "specific-humidity",
      "fields": ["QVAPOR"],
      "optional_fields": ["QCLOUD", "QRAIN", "QICE", "QSNOW", "QGRAUP", "QHAIL"],
      "below_ground": "lowest-level",
      "units": "kg kg**-1",
      "long_name": "Specific humidity",
      "standard_name": "specific_humidity",
      "short_name": "q",
      "param_id": 133,
      "comment": "Water vapour per kilogram of moist air: QVAPOR / (1 + QVAPOR + the condensate mixing ratios the file carries)."
    },
    {
      "id": "vertical_velocity",
      "kind": "level",
      "default": false,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "vertical_velocity", "era5": "w"},
      "op": "omega",
      "fields": ["W", "T", "P", "PB", "QVAPOR"],
      "below_ground": "lowest-level",
      "units": "Pa s**-1",
      "long_name": "Vertical velocity",
      "standard_name": "lagrangian_tendency_of_air_pressure",
      "short_name": "w",
      "param_id": 135,
      "comment": "Pressure vertical velocity (omega), as ERA5's w is: -g rho w with W unstaggered onto mass levels and rho from the virtual temperature."
    },
    {
      "id": "relative_humidity",
      "kind": "level",
      "default": false,
      "level_kinds": ["pressure", "model"],
      "names": {"wb2": "relative_humidity", "era5": "r"},
      "op": "rh-ifs",
      "fields": ["T", "P", "PB", "QVAPOR"],
      "below_ground": "lowest-level",
      "units": "%",
      "long_name": "Relative humidity",
      "standard_name": "relative_humidity",
      "short_name": "r",
      "param_id": 157,
      "comment": "With respect to water above 273.16 K, ice below 250.16 K and a quadratic blend between, as the IFS defines it. Not capped at 100 %, as ERA5's is not."
    },
    {
      "id": "pressure",
      "kind": "level",
      "default": true,
      "level_kinds": ["model"],
      "names": {"wb2": "pressure", "era5": "pres"},
      "op": "pressure",
      "fields": ["P", "PB"],
      "units": "Pa",
      "long_name": "Pressure",
      "standard_name": "air_pressure",
      "short_name": "pres",
      "param_id": 54,
      "comment": "P + PB on model levels."
    },
    {
      "id": "2m_temperature",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "2m_temperature", "era5": "t2m"},
      "op": "raw:T2",
      "fields": ["T2"],
      "units": "K",
      "long_name": "2 metre temperature",
      "standard_name": "air_temperature",
      "short_name": "2t",
      "param_id": 167
    },
    {
      "id": "10m_u_component_of_wind",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "10m_u_component_of_wind", "era5": "u10"},
      "op": "earth-wind10:u",
      "fields": ["U10", "V10", "SINALPHA", "COSALPHA"],
      "units": "m s**-1",
      "long_name": "10 metre U wind component",
      "standard_name": "eastward_wind",
      "short_name": "10u",
      "param_id": 165,
      "comment": "Earth-relative: rotated by the history file's SINALPHA and COSALPHA."
    },
    {
      "id": "10m_v_component_of_wind",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "10m_v_component_of_wind", "era5": "v10"},
      "op": "earth-wind10:v",
      "fields": ["U10", "V10", "SINALPHA", "COSALPHA"],
      "units": "m s**-1",
      "long_name": "10 metre V wind component",
      "standard_name": "northward_wind",
      "short_name": "10v",
      "param_id": 166,
      "comment": "Earth-relative: rotated by the history file's SINALPHA and COSALPHA."
    },
    {
      "id": "mean_sea_level_pressure",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "mean_sea_level_pressure", "era5": "msl"},
      "op": "slp",
      "fields": ["P", "PB", "T", "QVAPOR", "PH", "PHB"],
      "units": "Pa",
      "long_name": "Mean sea level pressure",
      "standard_name": "air_pressure_at_mean_sea_level",
      "short_name": "msl",
      "param_id": 151,
      "comment": "The Shuell (1995) reduction wrf-python's slp uses, not the IFS reduction: the two agree over water and can differ by a few hPa over high ground."
    },
    {
      "id": "surface_pressure",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "surface_pressure", "era5": "sp"},
      "op": "raw:PSFC",
      "fields": ["PSFC"],
      "units": "Pa",
      "long_name": "Surface pressure",
      "standard_name": "surface_air_pressure",
      "short_name": "sp",
      "param_id": 134
    },
    {
      "id": "total_precipitation",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "total_precipitation", "era5": "tp"},
      "op": "accumulation:interval",
      "fields": ["RAINNC"],
      "optional_fields": ["RAINC", "RAINSH", "I_RAINNC", "I_RAINC"],
      "units": "m",
      "long_name": "Total precipitation",
      "standard_name": "precipitation_amount",
      "short_name": "tp",
      "param_id": 228,
      "comment": "Precipitation over the interval since the previous exported time (RAINNC + RAINC + RAINSH, buckets included), in metres of water. Empty at the first time, which has no interval behind it."
    },
    {
      "id": "total_precipitation_6hr",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "total_precipitation_6hr", "era5": "tp_6h"},
      "op": "accumulation:6h",
      "fields": ["RAINNC"],
      "optional_fields": ["RAINC", "RAINSH", "I_RAINNC", "I_RAINC"],
      "units": "m",
      "long_name": "Total precipitation over 6 hours",
      "standard_name": "precipitation_amount",
      "short_name": "tp",
      "param_id": 228,
      "comment": "Precipitation over the 6 hours ending at the time, in metres of water. Empty where no exported time lies 6 hours earlier; left out of the dataset when none does."
    },
    {
      "id": "total_column_water_vapour",
      "kind": "surface",
      "default": true,
      "names": {"wb2": "total_column_water_vapour", "era5": "tcwv"},
      "op": "column-vapour",
      "fields": ["QVAPOR", "P", "PB", "PSFC"],
      "optional_fields": ["QCLOUD", "QRAIN", "QICE", "QSNOW", "QGRAUP", "QHAIL", "P_TOP"],
      "units": "kg m**-2",
      "long_name": "Total column vertically-integrated water vapour",
      "standard_name": "atmosphere_mass_content_of_water_vapor",
      "short_name": "tcwv",
      "param_id": 137,
      "comment": "Specific humidity integrated over the model column from the surface pressure to the model lid; layer interfaces between mass levels at the geometric mean of their pressures."
    },
    {
      "id": "geopotential_at_surface",
      "kind": "static",
      "default": true,
      "names": {"wb2": "geopotential_at_surface", "era5": "z_surface"},
      "op": "surface-geopotential",
      "fields": ["PH", "PHB"],
      "units": "m**2 s**-2",
      "long_name": "Geopotential",
      "standard_name": "surface_geopotential",
      "short_name": "z",
      "param_id": 129,
      "comment": "The model's own surface geopotential: PH + PHB at the bottom face, the base the level geopotential is measured from. Named z_surface under ERA5 names, because z is the level variable."
    },
    {
      "id": "land_sea_mask",
      "kind": "static",
      "default": true,
      "names": {"wb2": "land_sea_mask", "era5": "lsm"},
      "op": "raw:LANDMASK",
      "fields": ["LANDMASK"],
      "units": "(0 - 1)",
      "long_name": "Land-sea mask",
      "standard_name": "land_binary_mask",
      "short_name": "lsm",
      "param_id": 172,
      "comment": "1 land, 0 water (lakes are water, as in ERA5). A fraction after a latitude-longitude regrid."
