{
  "type": "object",
  "properties": {
    "card": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "woof-earth2-job-v1"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "ic_source": {
      "type": "string",
      "minLength": 1
    },
    "cycle": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:00:00Z$"
    },
    "hours": {
      "type": "integer",
      "minimum": 1
    },
    "storm": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nest_km": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "area": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "ensemble": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "members": {
              "type": "integer",
              "minimum": 1
            },
            "mix": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "members": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "source",
                  "members"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "members",
            "mix"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnose": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "export": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "earth2"
        ]
      }
    },
    "table": {
      "type": "object",
      "properties": {
        "file": {
          "const": "earth2-models.v1.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "model",
    "ic_source",
    "cycle",
    "hours",
    "storm",
    "nest_km",
    "area",
    "ensemble",
    "diagnose",
    "export",
    "table"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gpuwm:woof-earth2-job:v1",
  "title": "WOOF Earth-2 Job v1",
  "$comment": "Model/source membership, cadence, ordered bounds, canonical sorting, mix sum and table SHA256 are checked by gpuwm.earth2_door.build_spec and load_spec."
}
