  "target": {
    "name": "gpuwm/WRF-real NCEP AIGFS deterministic source, land surface pending cross-source composition",
    "physics_suite": "WSM6+YSU+classic-MM5+Noah4",
    "max_dom": 4,
    "require_lateral_boundaries": true,
    "target_vertical_levels": 49,
    "soil_layer_count": 0,
    "boundary_interval_seconds": 21600,
    "required_fields": [
      {"name": "air_temperature", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "K"},
      {"name": "specific_humidity", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "kg kg-1"},
      {"name": "eastward_wind", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m s-1"},
      {"name": "northward_wind", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m s-1"},
      {"name": "geopotential_height", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m"},
      {"name": "air_pressure", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "Pa"},
      {"name": "air_temperature_2m", "axes": ["y", "x"], "location": "surface", "target_units": "K"},
      {"name": "eastward_wind_10m", "axes": ["y", "x"], "location": "surface", "target_units": "m s-1"},
      {"name": "northward_wind_10m", "axes": ["y", "x"], "location": "surface", "target_units": "m s-1"}
    ],
    "pending_composition_requirements": [
      "land_fraction",
      "skin_temperature",
      "soil_temperature",
      "specific_humidity_2m",
      "surface_pressure",
      "terrain_height",
      "volumetric_soil_moisture"
    ],
    "pressure_requirement": "air_pressure",
    "policy_controlled_fields": [
      "cloud_water_mixing_ratio",
      "rain_water_mixing_ratio",
      "cloud_ice_mixing_ratio",
      "snow_mixing_ratio",
      "graupel_or_hail_mixing_ratio",
      "vertical_velocity",
      "snow_water_equivalent",
      "snow_depth",
      "sea_ice_fraction"
    ],
    "initialization_policies": {
      "cloud_water_mixing_ratio": "not_published_and_unresolvable_until_cross_source_composition",
      "rain_water_mixing_ratio": "not_published_and_unresolvable_until_cross_source_composition",
      "cloud_ice_mixing_ratio": "not_published_and_unresolvable_until_cross_source_composition",
      "snow_mixing_ratio": "not_published_and_unresolvable_until_cross_source_composition",
      "graupel_or_hail_mixing_ratio": "not_published_and_unresolvable_until_cross_source_composition",
      "vertical_velocity": "published_only_as_pressure_velocity_omega_conversion_owned_by_the_pending_cross_source_composition",
      "snow_water_equivalent": "not_published_in_operational_product",
      "snow_depth": "not_published_in_operational_product",
      "sea_ice_fraction": "not_published_in_operational_product"
    }
  }
