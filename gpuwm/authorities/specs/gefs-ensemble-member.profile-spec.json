{
  "schema": "gpuwm-source-profile-authoring-spec-v1",
  "about": [
    "NOAA GEFS v12 atmos 0.5-degree ensemble member (pgrb2a + pgrb2b).",
    "Every octet below was measured from the 2026-08-17 00Z cycle.  The",
    "31-level ladder is the exact union of the pair's disjoint isobaric",
    "sets; every state selector pins PDT 1 so a co-published mean or",
    "spread file can never satisfy a frame; the four soil layers are keyed",
    "by their scaled depth bounds because the integer level key collides.",
    "The soil selectors deliberately carry NO pdt pin: the composition's",
    "soil-selector grammar excludes template pins, and the mapping's soil",
    "selectors must match the composition's byte for byte.  The statistic",
    "defense is intact because every non-soil selector pins PDT 1."
  ],
  "constants": {
    "LEVELS": [
      100, 200, 300, 500, 700, 1000, 2000, 3000, 5000, 7000, 10000,
      15000, 20000, 25000, 30000, 35000, 40000, 45000, 50000, 55000,
      60000, 65000, 70000, 75000, 80000, 85000, 90000, 92500, 95000,
      97500, 100000
    ],
    "SOIL_BOUNDS": [
      {"top": 0.0, "bottom": 0.1},
      {"top": 0.1, "bottom": 0.4},
      {"top": 0.4, "bottom": 1.0},
      {"top": 1.0, "bottom": 2.0}
    ],
    "K": {"source": "K", "target": "K"},
    "Q": {"source": "kg kg-1", "target": "kg kg-1"},
    "WIND": {"source": "m s-1", "target": "m s-1"},
    "METRES": {"source": "m", "target": "m"},
    "PASCALS": {"source": "Pa", "target": "Pa"},
    "FRACTION": {"source": "1", "target": "1"},
    "SNOW_BITMAP_POLICY": "published_under_a_55_percent_ocean_bitmap_whose_surface_semantics_are_not_a_declared_engine_shape",
    "ZERO_FILL": "explicit_zero_with_adapter_validation"
  },
  "templates": {
    "selector": {
      "format": "grib2",
      "discipline": "$discipline",
      "category": "$category",
      "parameter": "$parameter",
      "level_type": "$level_type",
      "pdt": 1
    },
    "selector_at_level": {
      "format": "grib2",
      "discipline": "$discipline",
      "category": "$category",
      "parameter": "$parameter",
      "level_type": "$level_type",
      "level_value": "$level_value",
      "pdt": 1
    },
    "soil_selector": {
      "format": "grib2",
      "discipline": 2,
      "category": 0,
      "parameter": "$parameter",
      "center": 7,
      "subcenter": 2,
      "master_table_version": 2,
      "local_table_version": 1,
      "level_type": 106,
      "level_value": "$top",
      "second_level_type": 106,
      "second_level_value": "$bottom"
    },
    "field_3d": {
      "selectors": ["$selector"],
      "units": "$units",
      "source_axes": ["vertical", "y", "x"],
      "target_axes": ["vertical", "y", "x"],
      "location": "mass",
      "staggering": "none",
      "missing": {"kind": "reject"}
    },
    "field_2d": {
      "selectors": ["$selector"],
      "units": "$units",
      "source_axes": ["y", "x"],
      "target_axes": ["y", "x"],
      "location": "surface",
      "staggering": "none",
      "missing": {"kind": "reject"}
    },
    "field_soil": {
      "selectors": "$selectors",
      "units": "$units",
      "source_axes": ["soil", "y", "x"],
      "target_axes": ["soil", "y", "x"],
      "location": "soil",
      "staggering": "none",
      "missing": {"kind": "preserve_mask"}
    },
    "soil_source_layer": {
      "top": "$top",
      "bottom": "$bottom",
      "selectors": {
        "soil_temperature": {
          "$template": "soil_selector",
          "with": {"parameter": 2, "top": "$top", "bottom": "$bottom"}
        },
        "volumetric_soil_moisture": {
          "$template": "soil_selector",
          "with": {"parameter": 192, "top": "$top", "bottom": "$bottom"}
        }
      }
    },
    "soil_target_layer": {"top": "$top", "bottom": "$bottom"}
  },
  "documents": [
    {
      "output": "gpuwm/authorities/rw-wps-gefs-ensemble-grib2.mapping.json",
      "format": {"indent": 1},
      "base": {"kind": "empty"},
      "steps": [
        {
          "op": "set",
          "path": [],
          "value": {
            "schema": "rw-wps.mapping.v1",
            "name": "ncep-gefs-atmos-member-pgrb2a-plus-pgrb2b-half-degree",
            "format": "grib2",
            "coordinates": {
              "horizontal": {"kind": "embedded_grid"},
              "vertical": {
                "kind": "pressure",
                "units": "Pa",
                "positive": "down",
                "levels": {"$const": "LEVELS"}
              },
              "time": {"kind": "embedded_metadata"},
              "member": {"kind": "embedded_metadata"}
            },
            "fields": {
              "air_temperature": {
                "$template": "field_3d",
                "with": {
                  "selector": {"$template": "selector", "with": {"discipline": 0, "category": 0, "parameter": 0, "level_type": 100}},
                  "units": {"$const": "K"}
                }
              },
              "specific_humidity": {
                "$template": "field_3d",
                "with": {
                  "selector": {"$template": "selector", "with": {"discipline": 0, "category": 1, "parameter": 0, "level_type": 100}},
                  "units": {"$const": "Q"}
                }
              },
              "eastward_wind": {
                "$template": "field_3d",
                "with": {
                  "selector": {"$template": "selector", "with": {"discipline": 0, "category": 2, "parameter": 2, "level_type": 100}},
                  "units": {"$const": "WIND"}
                }
              },
              "northward_wind": {
                "$template": "field_3d",
                "with": {
                  "selector": {"$template": "selector", "with": {"discipline": 0, "category": 2, "parameter": 3, "level_type": 100}},
                  "units": {"$const": "WIND"}
                }
              },
              "geopotential_height": {
                "$template": "field_3d",
                "with": {
                  "selector": {"$template": "selector", "with": {"discipline": 0, "category": 3, "parameter": 5, "level_type": 100}},
                  "units": {"$const": "METRES"}
                }
              },
              "air_pressure": {
                "selectors": [],
                "derivation": "pressure-from-coordinate",
                "units": {"$const": "PASCALS"},
                "source_axes": ["vertical", "y", "x"],
                "target_axes": ["vertical", "y", "x"],
                "location": "mass",
                "staggering": "none",
                "missing": {"kind": "reject"}
              },
              "surface_pressure": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 3, "parameter": 0, "level_type": 1, "level_value": 0}},
                  "units": {"$const": "PASCALS"}
                }
              },
              "terrain_height": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 3, "parameter": 5, "level_type": 1, "level_value": 0}},
                  "units": {"$const": "METRES"}
                }
              },
              "skin_temperature": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 0, "parameter": 0, "level_type": 1, "level_value": 0}},
                  "units": {"$const": "K"}
                }
              },
              "air_temperature_2m": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 0, "parameter": 0, "level_type": 103, "level_value": 2}},
                  "units": {"$const": "K"}
                }
              },
              "specific_humidity_2m": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 1, "parameter": 0, "level_type": 103, "level_value": 2}},
                  "units": {"$const": "Q"}
                }
              },
              "eastward_wind_10m": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 2, "parameter": 2, "level_type": 103, "level_value": 10}},
                  "units": {"$const": "WIND"}
                }
              },
              "northward_wind_10m": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 0, "category": 2, "parameter": 3, "level_type": 103, "level_value": 10}},
                  "units": {"$const": "WIND"}
                }
              },
              "land_fraction": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 2, "category": 0, "parameter": 0, "level_type": 1, "level_value": 0}},
                  "units": {"source": "0/1 Flag", "target": "1"}
                }
              },
              "sea_ice_fraction": {
                "$template": "field_2d",
                "with": {
                  "selector": {"$template": "selector_at_level", "with": {"discipline": 10, "category": 2, "parameter": 0, "level_type": 1, "level_value": 0}},
                  "units": {"$const": "FRACTION"}
                }
              },
              "soil_temperature": {
                "$template": "field_soil",
                "with": {
                  "selectors": {"$expand": {"template": "soil_selector", "for_each": {"$const": "SOIL_BOUNDS"}, "with": {"parameter": 2}}},
                  "units": {"$const": "K"}
                }
              },
              "volumetric_soil_moisture": {
                "$template": "field_soil",
                "with": {
                  "selectors": {"$expand": {"template": "soil_selector", "for_each": {"$const": "SOIL_BOUNDS"}, "with": {"parameter": 192}}},
                  "units": {"source": "m3 m-3", "target": "m3 m-3"}
                }
              }
            },
            "derivations": [
              {"name": "pressure-from-coordinate", "operation": "pressure_from_vertical_coordinate"}
            ],
            "target": {
              "name": "gpuwm/WRF-real NCEP GEFS ensemble-member source",
              "physics_suite": "WSM6+YSU+classic-MM5+Noah4",
              "max_dom": 4,
              "require_lateral_boundaries": true,
              "target_vertical_levels": 49,
              "soil_layer_count": 4,
              "boundary_interval_seconds": 10800,
              "required_fields": [
                {"name": "air_temperature", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "K"},
                {"name": "specific_humidity", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "kg kg-1"},
                {"name": "eastward_wind", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m s-1"},
                {"name": "northward_wind", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m s-1"},
                {"name": "geopotential_height", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "m"},
                {"name": "air_pressure", "axes": ["vertical", "y", "x"], "location": "mass", "target_units": "Pa"},
                {"name": "surface_pressure", "axes": ["y", "x"], "location": "surface", "target_units": "Pa"},
                {"name": "terrain_height", "axes": ["y", "x"], "location": "surface", "target_units": "m"},
                {"name": "skin_temperature", "axes": ["y", "x"], "location": "surface", "target_units": "K"},
                {"name": "air_temperature_2m", "axes": ["y", "x"], "location": "surface", "target_units": "K"},
                {"name": "specific_humidity_2m", "axes": ["y", "x"], "location": "surface", "target_units": "kg kg-1"},
                {"name": "eastward_wind_10m", "axes": ["y", "x"], "location": "surface", "target_units": "m s-1"},
                {"name": "northward_wind_10m", "axes": ["y", "x"], "location": "surface", "target_units": "m s-1"},
                {"name": "land_fraction", "axes": ["y", "x"], "location": "surface", "target_units": "1"},
                {"name": "soil_temperature", "axes": ["soil", "y", "x"], "location": "soil", "target_units": "K"},
                {"name": "volumetric_soil_moisture", "axes": ["soil", "y", "x"], "location": "soil", "target_units": "m3 m-3"}
              ],
              "pressure_requirement": "air_pressure",
              "policy_controlled_fields": [
                "cloud_water_mixing_ratio", "rain_water_mixing_ratio",
                "cloud_ice_mixing_ratio", "snow_mixing_ratio",
                "graupel_or_hail_mixing_ratio", "vertical_velocity",
                "snow_water_equivalent", "snow_depth", "sea_ice_fraction"
              ],
              "initialization_policies": {
                "cloud_water_mixing_ratio": {"$const": "ZERO_FILL"},
                "rain_water_mixing_ratio": {"$const": "ZERO_FILL"},
                "cloud_ice_mixing_ratio": {"$const": "ZERO_FILL"},
                "snow_mixing_ratio": {"$const": "ZERO_FILL"},
                "graupel_or_hail_mixing_ratio": {"$const": "ZERO_FILL"},
                "vertical_velocity": {"$const": "ZERO_FILL"},
                "snow_water_equivalent": {"$const": "SNOW_BITMAP_POLICY"},
                "snow_depth": {"$const": "SNOW_BITMAP_POLICY"}
              }
            }
          }
        }
      ]
    },
    {
      "output": "gpuwm/authorities/rw-wps-gefs-ensemble-grib2.composition.json",
      "format": {"indent": 1},
      "base": {"kind": "empty"},
      "steps": [
        {
          "op": "set",
          "path": [],
          "value": {
            "schema": "gpuwm-mapped-composition-v2",
            "name": "gefs-member-pgrb2a-plus-pgrb2b-with-in-band-terrain-and-noah4-soil",
            "mapping_binding": "input_manifest_sha256",
            "supplements": {
              "terrain_height": {
                "data_role": "gefs_member_in_band_surface",
                "provenance_role": "gefs_member_in_band_surface_provenance",
                "format": "grib2",
                "field": "terrain_height",
                "selector_authority": "mapping_field_exact",
                "grid_alignment": "exact_coordinate_subset",
                "time_alignment": "valid_time_exact",
                "require_invariant_across_time": true
              }
            },
            "soil_layers": {
              "temperature_field": "soil_temperature",
              "moisture_field": "volumetric_soil_moisture",
              "depth_units": "m",
              "source_layers": {"$expand": {"template": "soil_source_layer", "for_each": {"$const": "SOIL_BOUNDS"}}},
              "target_layers": {"$expand": {"template": "soil_target_layer", "for_each": {"$const": "SOIL_BOUNDS"}}},
              "remap": {
                "kind": "conservative_layer_means",
                "source_value_location": "layer_mean",
                "target_value_location": "layer_mean",
                "coverage": "require_complete"
              },
              "missing": {
                "land": "reject",
                "ocean": {
                  "stage": "after_horizontal_interpolation",
                  "temperature": "skin_temperature",
                  "moisture": 1.0
                }
              }
            }
          }
        }
      ]
    },
    {
      "output": "gpuwm/authorities/rw-wps-gefs-ensemble-grib2.provenance.json",
      "format": {"indent": 1},
      "base": {"kind": "empty"},
      "steps": [
        {
          "op": "set",
          "path": [],
          "value": {
            "schema": "gpuwm-gefs-member-in-band-terrain-provenance-v1",
            "source": "NOAA GEFS v12 atmos 0.5-degree member products (pgrb2a + pgrb2b, noaa-gefs-pds)",
            "field": "terrain_height",
            "selector": {
              "format": "grib2",
              "discipline": 0,
              "category": 3,
              "parameter": 5,
              "level_type": 1,
              "level_value": 0,
              "pdt": 1
            },
            "time_policy": "decoded at every valid time and required invariant",
            "member_policy": "one member per preparation: the member axis is carried in every message's PDT (perturbationNumber / typeOfEnsembleForecast) and the frame assembler refuses inputs that mix members; which members exist and how their bytes verify is the packaged rw-wps.members.v1 grammar consumed by gpuwm-member-prep",
            "input_identity": "dynamic file paths and SHA-256 values are owned by gpuwm-mapped-composition-inputs-v1"
          }
        }
      ]
    }
  ]
}
