  "backends": {
    "wuduan": {
      "fields": [
        "u10m",
        "v10m",
        "msl",
        "u850",
        "v850"
      ],
      "path_search_distance": 300,
      "path_search_window_size": 2,
      "edge_radius_km": 300,
      "constructor": {
        "path_search_distance": 300,
        "path_search_window_size": 2
      },
      "vorticity_threshold": 0.00014
    },
    "vitart": {
      "fields": [
        "u10m",
        "v10m",
        "msl",
        "u850",
        "v850",
        "z500",
        "z850",
        "z200",
        "t500",
        "t400",
        "t300",
        "t250",
        "t200"
      ],
      "path_search_distance": 300,
      "path_search_window_size": 2,
      "edge_radius_km": 300,
      "constructor": {
        "path_search_distance": 300,
        "path_search_window_size": 2,
        "vorticity_threshold": 3.5e-05,
        "mslp_threshold": 99000.0,
        "temp_dec_threshold": 0.5,
        "lat_threshold": null,
        "exclude_border": true
      },
      "center_refinement": {
        "field": "msl",
        "method": "separable three-point parabola about the msl-minimum lattice node the tracker returns",
        "reason": "Vitart returns lattice nodes, so every fix sat on the 0.25 degree export grid and tracks drew as staircases (improve-55)"
      }
    },
    "tempestextremes": {
      "fields": [
        "msl",
        "u10m",
        "v10m",
        "z300",
        "z500"
      ],
      "detect": [
        "--searchbymin",
        "msl",
        "--closedcontourcmd",
        "msl,200.0,5.5,0;_DIFF(z300,z500),-58.8,6.5,1.0",
        "--mergedist",
        "6.0",
        "--outputcmd",
        "msl,min,0;_VECMAG(u10m,v10m),max,2.0"
      ],
      "stitch": [
        "--range",
        "6.0",
        "--maxgap",
        "12h"
      ],
      "minimum_duration_seconds": 86400,
      "short_record_policy": "require-full-record-and-mark-provisional",
      "edge_radius_km": 722.5
    }
  },
  "best_track_formats": {
    "atcf": {
      "delimiter": ",",
      "filter_column": 4,
      "filter_value": "BEST",
      "time": 2,
      "minute": 3,
      "lat": 6,
      "lon": 7,
      "wind_knots": 8,
      "pressure_hpa": 9,
      "coordinate_scale": 0.1
    },
    "hurdat2": {
      "delimiter": ",",
      "date": 0,
      "hhmm": 1,
      "status": 3,
      "lat": 4,
      "lon": 5,
      "wind_knots": 6,
      "pressure_hpa": 7,
      "record_identifier": 2,
      "coordinate_scale": 1.0
    }
  },
