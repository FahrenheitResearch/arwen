    "arithmetic_contract": {
      "type": "object"
    },
    "code": {
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "description": "the verbatim return of gpuwm.supervisor.git_commit, including its 'unavailable: <stderr>' form",
          "type": "string"
        },
        "gpuwm_version": {
          "type": "string"
        },
        "runtime_source_sha256": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "tree_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_clean": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "gpuwm_version",
        "git_commit",
        "tree_sha256",
        "worktree_clean",
        "runtime_source_sha256"
      ],
      "type": "object"
    },
    "emission_site": {
      "description": "which forecast exit wrote this capsule",
      "enum": [
        "runtime.run_experiment:single-domain",
        "runtime.run_experiment:domain-tree",
        "prepared_single_domain_forecast",
        "prepared_domain_tree_forecast",
        "supervisor:success"
      ]
    },
    "input_bytes": {
      "type": "object"
    },
    "kernel_manifest": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "compiled_image": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "ptx",
                  "cubin"
                ]
              },
              "reason": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "status": {
                "enum": [
                  "resolved",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "source_sha256",
          "options",
          "compiled_image"
        ],
        "type": "object"
      },
      "description": "one entry per translation unit the run compiled, keyed by module; the option tuple is per module, never global",
      "type": "object"
    },
