      "value_axes": "time,lat,lon",
      "latitude_variable": "lat",
      "longitude_variable": "lon",
      "time_variable": "time",
      "time_units": "hours since 1800-01-01 00:00:0.0",
      "time_origin": "1800-01-01T00:00:00Z",
      "time_value_seconds": 3600,
      "period_end_offset_seconds": 43200,
      "accumulation_seconds": 86400,
      "required_root_attributes": {
        "title": "CPC Unified Gauge-Based Analysis of Daily Precipitation over CONUS RT at PSD",
        "Comments": "Preciptation is accumulated from 12z of previous day to 12z of day stored"
      }
    }
  ]
}
