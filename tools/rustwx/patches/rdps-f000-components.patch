     #[test]
+    fn rdps_full_initialization_omits_only_the_unpublished_accumulation_interval() {
+        let cycle = CycleSpec::new("20260908", 0).unwrap();
+        let profile = IngestProfile::full();
+        let cancel = AtomicBool::new(false);
+        let sink = |_event: IngestEvent| {};
+        let config = IngestConfig {
+            model: ModelId::Rdps, cycle: &cycle, source_override: Some(SourceId::Eccc),
+            cache_root: Path::new("unused-cache"), use_cache: true, store_root: Path::new("unused-store"),
+            model_slug: "rdps", run_slug: "20260908-00", profile: &profile, verify: true,
+            progress: &sink, cancel: &cancel,
+        };
+        let initial = provider_component_products(&config, 0, "rws-surface").unwrap().unwrap();
+        assert_eq!(initial.len(), 9);
+        for component in ["AirTemp_AGL-2m", "DewPoint_AGL-2m", "WindU_AGL-10m", "WindV_AGL-10m", "Pressure_MSL", "Pressure_Sfc", "RelativeHumidity_AGL-2m", "WindGust_AGL-10m", "TotalCloudCover_Sfc"] {
+            assert!(initial.iter().any(|value| value == component), "missing required {component}");
+        }
+        for hour in [1, 6, 48, 84] {
+            let later = provider_component_products(&config, hour, "rws-surface").unwrap().unwrap();
+            assert_eq!(later.len(), 10);
+            assert!(later.iter().any(|component| component == "Precip-Accum_Sfc"));
+            assert_eq!(later.into_iter().filter(|component| component != "Precip-Accum_Sfc").collect::<Vec<_>>(), initial);
+        }
+        assert_eq!(provider_component_products(&config, 0, "rws-pressure").unwrap(), provider_component_products(&config, 1, "rws-pressure").unwrap());
+    }
