+SUBROUTINE gpuwm_dump_dtbc_oracle ( grid )
+   USE module_domain, ONLY : domain, get_ijk_from_grid
+   IMPLICIT NONE
+   TYPE(domain), INTENT(IN) :: grid
+   CHARACTER(LEN=1024) dump_path
+   INTEGER dump_unit, env_status, path_len, ios
+   INTEGER ids, ide, jds, jde, kds, kde, &
+           ims, ime, jms, jme, kms, kme, &
+           ips, ipe, jps, jpe, kps, kpe
+   INTEGER(KIND=4) domain_i, ordinal_i, count_i
+   INTEGER, SAVE :: oracle_step_ordinal = 0
+   LOGICAL dump_exists
+   REAL(KIND=4) dtbc_i, values(6)
+
+   IF ( .NOT. grid%nested ) RETURN
+   IF ( oracle_step_ordinal .GE. grid%parent_time_step_ratio ) RETURN
+   dump_path = ''
+   CALL GET_ENVIRONMENT_VARIABLE ( 'GPUWM_WRF_ORACLE_DUMP', dump_path, &
+                                   LENGTH=path_len, STATUS=env_status )
+   IF ( env_status .EQ. 1 .OR. path_len .EQ. 0 ) RETURN
+   IF ( env_status .NE. 0 ) THEN
+      CALL wrf_error_fatal ( 'GPUWM_WRF_ORACLE_DUMP path is too long' )
+   ENDIF
+   INQUIRE ( FILE=dump_path(1:path_len), EXIST=dump_exists )
+   IF ( .NOT. dump_exists ) RETURN
+
+   CALL get_ijk_from_grid ( grid, &
+                            ids, ide, jds, jde, kds, kde, &
+                            ims, ime, jms, jme, kms, kme, &
+                            ips, ipe, jps, jpe, kps, kpe )
+   values(1) = grid%u_bxs(jds,kds,1) + &
+               grid%dtbc * grid%u_btxs(jds,kds,1)
+   values(2) = grid%v_bys(ids,kds,1) + &
+               grid%dtbc * grid%v_btys(ids,kds,1)
+   values(3) = grid%t_bxe(jds,kds,1) + &
+               grid%dtbc * grid%t_btxe(jds,kds,1)
+   values(4) = grid%w_bye(ids,kds,1) + &
+               grid%dtbc * grid%w_btye(ids,kds,1)
+   values(5) = grid%ph_bxs(jds,kds,1) + &
+               grid%dtbc * grid%ph_btxs(jds,kds,1)
+   values(6) = grid%mu_bys(ids,1,1) + &
+               grid%dtbc * grid%mu_btys(ids,1,1)
+
+   OPEN ( NEWUNIT=dump_unit, FILE=dump_path(1:path_len), &
+          STATUS='OLD', POSITION='APPEND', ACCESS='STREAM', &
+          FORM='UNFORMATTED', ACTION='WRITE', IOSTAT=ios )
+   IF ( ios .NE. 0 ) THEN
+      CALL wrf_error_fatal ( 'cannot append N1.5 dtbc oracle' )
+   ENDIF
+   oracle_step_ordinal = oracle_step_ordinal + 1
+   domain_i = grid%id
+   ordinal_i = oracle_step_ordinal
+   dtbc_i = grid%dtbc
+   count_i = SIZE(values)
+   WRITE ( dump_unit ) 'DBDY', domain_i, ordinal_i, dtbc_i, count_i, values
+   CLOSE ( dump_unit, IOSTAT=ios )
+   IF ( ios .NE. 0 ) THEN
+      CALL wrf_error_fatal ( 'failed to close N1.5 dtbc oracle' )
+   ENDIF
+   RETURN
+END SUBROUTINE gpuwm_dump_dtbc_oracle
