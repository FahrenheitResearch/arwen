+              ngrid%scalar_bxe(jds:jde-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_bys(ids:ide-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_bye(ids:ide-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_btxs(jds:jde-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_btxe(jds:jde-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_btys(ids:ide-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace), &
+              ngrid%scalar_btye(ids:ide-1,kds:kde-1,1:ngrid%spec_bdy_width,itrace) )
+      ENDDO
+
+      WRITE ( dump_unit ) 'DONE', oracle_record_count
+      CLOSE ( dump_unit, IOSTAT=ios )
+      IF ( ios .NE. 0 ) THEN
+         CALL wrf_error_fatal ( 'failed to close GPUWM N1.5 dump' )
+      ENDIF
+      WRITE ( message, '(A,A,A,I0)' ) 'GPUWM N1.5 dump: ', &
+              dump_path(1:path_len), ' tables=', oracle_record_count
+      CALL wrf_message ( TRIM(message) )
+   END SUBROUTINE gpuwm_dump_nest_tables
+
+   SUBROUTINE gpuwm_finish_force_dump ( ngrid, pgrid )
+      TYPE(domain), POINTER :: ngrid, pgrid
+      CHARACTER(LEN=1024) dump_path
+      INTEGER dump_unit, env_status, path_len, ios
+
+      IF ( .NOT. oracle_enabled ) RETURN
+      dump_path = ''
+      CALL GET_ENVIRONMENT_VARIABLE ( 'GPUWM_WRF_ORACLE_DUMP', dump_path, &
+                                      LENGTH=path_len, STATUS=env_status )
+      IF ( env_status .NE. 0 .OR. path_len .EQ. 0 ) THEN
+         CALL wrf_error_fatal ( 'GPUWM_WRF_ORACLE_DUMP disappeared' )
+      ENDIF
+      OPEN ( NEWUNIT=dump_unit, FILE=dump_path(1:path_len), &
+             STATUS='OLD', POSITION='APPEND', ACCESS='STREAM', &
+             FORM='UNFORMATTED', ACTION='WRITE', IOSTAT=ios )
+      IF ( ios .NE. 0 ) THEN
+         CALL wrf_error_fatal ( 'cannot append N1.5 post-force samples' )
+      ENDIF
+      CALL gpuwm_dump_prognostic ( dump_unit, 'after', pgrid )
+      CALL gpuwm_dump_prognostic ( dump_unit, 'after', ngrid )
+      CLOSE ( dump_unit, IOSTAT=ios )
+      IF ( ios .NE. 0 ) THEN
+         CALL wrf_error_fatal ( 'failed to close N1.5 post-force samples' )
+      ENDIF
+      oracle_dumped = .TRUE.
+      oracle_enabled = .FALSE.
+   END SUBROUTINE gpuwm_finish_force_dump
+
+   SUBROUTINE gpuwm_dump_prognostic ( unit, phase_in, dgrid )
+      INTEGER, INTENT(IN) :: unit
+      CHARACTER(LEN=*), INTENT(IN) :: phase_in
+      TYPE(domain), POINTER :: dgrid
+      CHARACTER(LEN=8) phase
+      INTEGER ids, ide, jds, jde, kds, kde, &
+              ims, ime, jms, jme, kms, kme, &
+              ips, ipe, jps, jpe, kps, kpe
+      INTEGER il, ih, jl, jh, kl, kh
+      INTEGER(KIND=4) domain_i, count_i
+      REAL(KIND=4) values(12)
+
+      CALL get_ijk_from_grid ( dgrid, &
+                               ids, ide, jds, jde, kds, kde, &
+                               ims, ime, jms, jme, kms, kme, &
+                               ips, ipe, jps, jpe, kps, kpe )
+      il = MAX(ids,ips)
+      ih = MIN(ide-1,ipe)
+      jl = MAX(jds,jps)
+      jh = MIN(jde-1,jpe)
+      kl = MAX(kds,kps)
+      kh = MIN(kde-1,kpe)
+      values = (/ dgrid%mu_2(il,jl), dgrid%t_2(il,kl,jl), &
+                  dgrid%u_2(il,kl,jl), dgrid%v_2(il,kl,jl), &
+                  dgrid%w_2(il,kl,jl), dgrid%ph_2(il,kl,jl), &
+                  dgrid%mu_2(ih,jh), dgrid%t_2(ih,kh,jh), &
+                  dgrid%u_2(ih,kh,jh), dgrid%v_2(ih,kh,jh), &
+                  dgrid%w_2(ih,kh,jh), dgrid%ph_2(ih,kh,jh) /)
+      phase = phase_in
+      domain_i = dgrid%id
+      count_i = SIZE(values)
+      WRITE ( unit ) 'PROG', phase, domain_i, count_i, values
+   END SUBROUTINE gpuwm_dump_prognostic
+
+   SUBROUTINE gpuwm_dump_eight ( unit, family, field, &
+                                 bxs, bxe, bys, bye, &
+                                 btxs, btxe, btys, btye )
+      INTEGER, INTENT(IN) :: unit
+      CHARACTER(LEN=*), INTENT(IN) :: family, field
+      REAL, DIMENSION(:,:,:), INTENT(IN) :: bxs, bxe, bys, bye
+      REAL, DIMENSION(:,:,:), INTENT(IN) :: btxs, btxe, btys, btye
+      CALL gpuwm_dump_table ( unit, family, field, 'xs', 'value', bxs )
+      CALL gpuwm_dump_table ( unit, family, field, 'xe', 'value', bxe )
+      CALL gpuwm_dump_table ( unit, family, field, 'ys', 'value', bys )
+      CALL gpuwm_dump_table ( unit, family, field, 'ye', 'value', bye )
+      CALL gpuwm_dump_table ( unit, family, field, 'xs', 'tendency', btxs )
+      CALL gpuwm_dump_table ( unit, family, field, 'xe', 'tendency', btxe )
+      CALL gpuwm_dump_table ( unit, family, field, 'ys', 'tendency', btys )
+      CALL gpuwm_dump_table ( unit, family, field, 'ye', 'tendency', btye )
+   END SUBROUTINE gpuwm_dump_eight
+
+   SUBROUTINE gpuwm_dump_table ( unit, family_in, field_in, side_in, &
+                                 kind_in, values )
+      INTEGER, INTENT(IN) :: unit
+      CHARACTER(LEN=*), INTENT(IN) :: family_in, field_in, side_in, kind_in
+      REAL, DIMENSION(:,:,:), INTENT(IN) :: values
+      CHARACTER(LEN=8) family, kind
+      CHARACTER(LEN=32) field
+      CHARACTER(LEN=2) side
+      INTEGER(KIND=4) dims(3)
+      family = family_in
+      field = field_in
+      side = side_in
+      kind = kind_in
+      dims = SHAPE(values)
+      WRITE ( unit ) 'TABL', family, field, side, kind, dims
+      WRITE ( unit ) values
+      oracle_record_count = oracle_record_count + 1
+   END SUBROUTINE gpuwm_dump_table
+
+END SUBROUTINE med_force_domain
