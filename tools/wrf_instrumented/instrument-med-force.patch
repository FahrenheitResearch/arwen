+   SUBROUTINE gpuwm_begin_force_dump ( ngrid, pgrid, nconfig )
+      TYPE(domain), POINTER :: ngrid, pgrid
+      TYPE(grid_config_rec_type), INTENT(IN) :: nconfig
+      CHARACTER(LEN=1024) dump_path
+      CHARACTER(LEN=2048) message
+      CHARACTER(LEN=16) magic
+      INTEGER dump_unit, env_status, path_len, ios
+      INTEGER ids, ide, jds, jde, kds, kde, &
+              ims, ime, jms, jme, kms, kme, &
+              ips, ipe, jps, jpe, kps, kpe
+      INTEGER(KIND=4) marker, header_i(8), bounds_i(6)
+      REAL(KIND=4) dt_i(2)
+
+      oracle_enabled = .FALSE.
+      IF ( oracle_dumped ) RETURN
+      IF ( .NOT. ( ngrid%active_this_task .AND. &
+                   pgrid%active_this_task ) ) RETURN
+      dump_path = ''
+      CALL GET_ENVIRONMENT_VARIABLE ( 'GPUWM_WRF_ORACLE_DUMP', dump_path, &
+                                      LENGTH=path_len, STATUS=env_status )
+      IF ( env_status .EQ. 1 .OR. path_len .EQ. 0 ) RETURN
+      IF ( env_status .NE. 0 ) THEN
+         CALL wrf_error_fatal ( 'GPUWM_WRF_ORACLE_DUMP path is too long' )
+      ENDIF
+
+      CALL get_ijk_from_grid ( ngrid, &
+                               ids, ide, jds, jde, kds, kde, &
+                               ims, ime, jms, jme, kms, kme, &
+                               ips, ipe, jps, jpe, kps, kpe )
+
+      OPEN ( NEWUNIT=dump_unit, FILE=dump_path(1:path_len), &
+             STATUS='REPLACE', ACCESS='STREAM', FORM='UNFORMATTED', &
+             ACTION='WRITE', IOSTAT=ios )
+      IF ( ios .NE. 0 ) THEN
+         WRITE ( message, '(A,A,A,I0)' ) 'cannot open N1.5 dump ', &
+                 dump_path(1:path_len), '; iostat=', ios
+         CALL wrf_error_fatal ( TRIM(message) )
+      ENDIF
+
+      magic = 'GPUWM-N1P5-DUMP1'
+      marker = 16909060
+      header_i = (/ 1, ngrid%id, pgrid%id, 1, nconfig%mp_physics, &
+                    ngrid%spec_bdy_width, &
+                    MAX(0, SIZE(ngrid%moist,4)-PARAM_FIRST_SCALAR+1), &
+                    MAX(0, SIZE(ngrid%scalar,4)-PARAM_FIRST_SCALAR+1) /)
+      dt_i = (/ pgrid%dt, ngrid%dt /)
+      bounds_i = (/ ids, ide, jds, jde, kds, kde /)
+      WRITE ( dump_unit ) magic
+      WRITE ( dump_unit ) marker
+      WRITE ( dump_unit ) header_i
+      WRITE ( dump_unit ) dt_i
+      WRITE ( dump_unit ) bounds_i
+      CALL gpuwm_dump_prognostic ( dump_unit, 'before', pgrid )
+      CALL gpuwm_dump_prognostic ( dump_unit, 'before', ngrid )
+      CALL gpuwm_dump_force_inputs ( dump_unit, pgrid )
+      CALL gpuwm_dump_force_inputs ( dump_unit, ngrid )
+      CLOSE ( dump_unit, IOSTAT=ios )
+      IF ( ios .NE. 0 ) THEN
+         CALL wrf_error_fatal ( 'failed to close GPUWM N1.5 dump header' )
+      ENDIF
+      oracle_enabled = .TRUE.
+   END SUBROUTINE gpuwm_begin_force_dump
+
+   SUBROUTINE gpuwm_dump_force_inputs ( unit, dgrid )
+      INTEGER, INTENT(IN) :: unit
+      TYPE(domain), POINTER :: dgrid
+      INTEGER ids, ide, jds, jde, kds, kde, &
+              ims, ime, jms, jme, kms, kme, &
+              ips, ipe, jps, jpe, kps, kpe
+      INTEGER itrace
+
+      CALL get_ijk_from_grid ( dgrid, &
+                               ids, ide, jds, jde, kds, kde, &
+                               ims, ime, jms, jme, kms, kme, &
+                               ips, ipe, jps, jpe, kps, kpe )
+
+      ! Complete uncoupled BEFORE operands.  The producer restores these
+      ! into gpuwm-layout arrays and performs coupling into fresh scratch;
+      ! the WRF state itself is never reused as a candidate table.
+      CALL gpuwm_dump_input_2d ( unit, dgrid%id, 'state', 'mu', &
+           dgrid%mu_2(ids:ide-1,jds:jde-1) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'state', 'u', &
+           dgrid%u_2(ids:ide,kds:kde-1,jds:jde-1) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'state', 'v', &
+           dgrid%v_2(ids:ide-1,kds:kde-1,jds:jde) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'state', 'w', &
+           dgrid%w_2(ids:ide-1,kds:kde,jds:jde-1) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'state', 't', &
+           dgrid%t_2(ids:ide-1,kds:kde-1,jds:jde-1) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'state', 'ph', &
+           dgrid%ph_2(ids:ide-1,kds:kde,jds:jde-1) )
+
+      DO itrace = PARAM_FIRST_SCALAR, SIZE(dgrid%moist,4)
+         CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'moist', &
+              moist_dname_table(dgrid%id,itrace), &
+              dgrid%moist(ids:ide-1,kds:kde-1,jds:jde-1,itrace) )
+      ENDDO
+      DO itrace = PARAM_FIRST_SCALAR, SIZE(dgrid%scalar,4)
+         CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'scalar', &
+              scalar_dname_table(dgrid%id,itrace), &
+              dgrid%scalar(ids:ide-1,kds:kde-1,jds:jde-1,itrace) )
+      ENDDO
+
+      CALL gpuwm_dump_input_2d ( unit, dgrid%id, 'aux', 'mub', &
+           dgrid%mub(ids:ide-1,jds:jde-1) )
+      CALL gpuwm_dump_input_3d ( unit, dgrid%id, 'aux', 't_init', &
+           dgrid%t_init(ids:ide-1,kds:kde-1,jds:jde-1) )
+      CALL gpuwm_dump_input_1d ( unit, dgrid%id, 'aux', 'c1h', &
+           dgrid%c1h(kds:kde-1) )
+      CALL gpuwm_dump_input_1d ( unit, dgrid%id, 'aux', 'c2h', &
+           dgrid%c2h(kds:kde-1) )
+      CALL gpuwm_dump_input_1d ( unit, dgrid%id, 'aux', 'c1f', &
+           dgrid%c1f(kds:kde) )
+      CALL gpuwm_dump_input_1d ( unit, dgrid%id, 'aux', 'c2f', &
+           dgrid%c2f(kds:kde) )
+      CALL gpuwm_dump_input_2d ( unit, dgrid%id, 'aux', 'msft', &
+           dgrid%msfty(ids:ide-1,jds:jde-1) )
+      CALL gpuwm_dump_input_2d ( unit, dgrid%id, 'aux', 'msfu', &
+           dgrid%msfuy(ids:ide,jds:jde-1) )
+      CALL gpuwm_dump_input_2d ( unit, dgrid%id, 'aux', 'msfv', &
+           dgrid%msfvx(ids:ide-1,jds:jde) )
+   END SUBROUTINE gpuwm_dump_force_inputs
+
+   SUBROUTINE gpuwm_dump_input_1d ( unit, domain, family_in, field_in, values )
+      INTEGER, INTENT(IN) :: unit, domain
+      CHARACTER(LEN=*), INTENT(IN) :: family_in, field_in
+      REAL, DIMENSION(:), INTENT(IN) :: values
+      CHARACTER(LEN=8) phase, family
+      CHARACTER(LEN=32) field
+      INTEGER(KIND=4) domain_i, rank_i, dims_i(3)
+      phase = 'before'
+      family = family_in
+      field = field_in
+      domain_i = domain
+      rank_i = 1
+      dims_i = (/ SIZE(values,1), 0, 0 /)
+      WRITE ( unit ) 'INPT', phase, domain_i, family, field, rank_i, dims_i
+      WRITE ( unit ) values
+   END SUBROUTINE gpuwm_dump_input_1d
+
+   SUBROUTINE gpuwm_dump_input_2d ( unit, domain, family_in, field_in, values )
+      INTEGER, INTENT(IN) :: unit, domain
+      CHARACTER(LEN=*), INTENT(IN) :: family_in, field_in
+      REAL, DIMENSION(:,:), INTENT(IN) :: values
+      CHARACTER(LEN=8) phase, family
+      CHARACTER(LEN=32) field
+      INTEGER(KIND=4) domain_i, rank_i, dims_i(3)
+      phase = 'before'
+      family = family_in
+      field = field_in
+      domain_i = domain
+      rank_i = 2
+      dims_i = (/ SHAPE(values), 0 /)
+      WRITE ( unit ) 'INPT', phase, domain_i, family, field, rank_i, dims_i
+      WRITE ( unit ) values
+   END SUBROUTINE gpuwm_dump_input_2d
+
+   SUBROUTINE gpuwm_dump_input_3d ( unit, domain, family_in, field_in, values )
+      INTEGER, INTENT(IN) :: unit, domain
+      CHARACTER(LEN=*), INTENT(IN) :: family_in, field_in
+      REAL, DIMENSION(:,:,:), INTENT(IN) :: values
+      CHARACTER(LEN=8) phase, family
+      CHARACTER(LEN=32) field
+      INTEGER(KIND=4) domain_i, rank_i, dims_i(3)
+      phase = 'before'
+      family = family_in
+      field = field_in
+      domain_i = domain
+      rank_i = 3
+      dims_i = SHAPE(values)
+      WRITE ( unit ) 'INPT', phase, domain_i, family, field, rank_i, dims_i
+      WRITE ( unit ) values
+   END SUBROUTINE gpuwm_dump_input_3d
+
