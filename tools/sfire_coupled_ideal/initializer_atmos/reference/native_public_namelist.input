&time_control
 run_seconds=1, history_interval_s=1,
 start_year=2025, start_month=7, start_day=1, start_hour=12,
/
&domains
 max_dom=1, e_we=13, e_sn=11, e_vert=7,
 dx=73.5, dy=90., ztop=4000., time_step=0,
 time_step_fract_num=1, time_step_fract_den=3,
 sr_x=3, sr_y=4,
/
&dynamics
 hybrid_opt=3, tracer_opt=3,
/
&bdy_control
 open_xs=.true., open_xe=.true., open_ys=.true., open_ye=.true.,
/
&fire
 ifire=2, fire_fuel_read=0, fire_fuel_cat=3, fire_fmc_read=0,
 fire_boundary_guard=2, fmoist_run=.true., fmoist_interp=.true., fmoist_freq=1,
 fire_num_ignitions=1, fire_ignition_start_x1=367.5, fire_ignition_end_x1=367.5,
 fire_ignition_start_y1=450., fire_ignition_end_y1=450., fire_ignition_radius1=45.,
 fire_ignition_start_time1=0., fire_ignition_end_time1=0., fire_ignition_ros1=100.,
/
