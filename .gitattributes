gpuwm/data/urban/URBPARM.TBL -whitespace
gpuwm/data/urban/URBPARM_LCZ.TBL -whitespace
gpuwm/core/kernels/glibc_trig_flt32.cuh -whitespace
tools/urban_wrf471_oracle/couple_noahdrv_1679_1776.inc -whitespace
tools/urban_wrf471_oracle/couple_noahmpdrv_3363_3372_3689_3776.inc -whitespace
tools/uwpbl_wrf471_oracle/libm64/*.objdump.txt -whitespace
tools/uwpbl_wrf471_oracle/libm64/upstream/*.c -whitespace

# Byte-unmodified WRF lake oracle sources retain upstream trailing blanks.
# Their SHA-256 values are bound in gpuwm/data/lake/oracle/manifest.json.
tools/lake_wrf461_oracle/upstream/** -whitespace

# YSU's topo_wind arm (lane/282-terrain-drag), byte-pinned by
# tests/test_kernel_source_freeze_per_module.py PINNED_HEADERS and graded with
# ysu.cu by tests/test_terrain_drag_wrf471_parity.py: the 2.8.2 cut battery's
