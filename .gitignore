__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/
out/
*.nc
# Declared config artifacts are tracked: the repo-wide *.nc rule silently
# dropped the committed source-orography assets from a plain `git add`
# once (they had to be force-added at 4dd3e82).  Output/scratch NetCDF
# stays ignored; anything under configs/ is a deliberate, reviewed asset.
!configs/**/*.nc
# Externalized table asset: published as a GitHub release asset and
# staged by `gpuwm fetch-tables` (never in the public git history --
# GitHub rejects blobs over 100 MiB).  The development tree force-tracks
# its copy as the source of truth; a fetched copy in any other checkout
# must not show up as dirt.
gpuwm/data/thompson/tables/freezeH2O.dat
*.png
!docs/**
.superpowers/
.worktrees/
tools/grib1_bridge/target/
tools/hrrr_grib2_bridge-*
.pytest-ckpt/
!tools/grib1_bridge/vendor/**
tools/region_global_dealias/target/
tools/rustwx/target/
!tools/rustwx/vendor/**
# ... but not build output or a lock file cargo drops there when an
# excluded vendor crate is built on its own manifest.  Build the
# workspace target instead:
#   cargo test --offline --manifest-path vendor/wx-radar/Cargo.toml \n#     --target-dir target
tools/rustwx/vendor/**/target/
tools/rustwx/vendor/wx-radar/Cargo.lock
!tools/rustwx/assets/**
# The two vendor negations above exist so an offline `cargo build` has
# its crates, and they re-admit EVERYTHING under those trees -- including
# the __pycache__ that `python -m compileall -q gpuwm tools` writes
# beside the handful of Python scripts some crates vendor.  That is how
# five .pyc files reached a release-branch commit.  Vendored sources
# still ship; their bytecode does not.
tools/grib1_bridge/vendor/**/__pycache__/
tools/rustwx/vendor/**/__pycache__/

# Scratch for live acceptance runs (fetched GRIB, decoded arrays, prepared
# wrfinput/wrfbdy).  Real data, reproducible from the commands in the
# handoff report, and never a build input.
/cache/

# the object cache the observation front doors default to when a
# caller names no --cache directory
.rw-obs-cache/

# Scratch output from tools/da_synthetic_cycle runs (dirs and redirect files).
.gate-*

# gpuwm/data/thompson/tables/CCN_ACTIVATE.BIN was ignored here until
# 2026-08-01.  It is now committed and shipped: it is WRF v4.6.1's own
# run/CCN_ACTIVATE.BIN under WRF's public-domain dedication, and the notice
# travels with it in LICENSE-WRF.txt.  See gpuwm/data/thompson/PROVENANCE.md.
